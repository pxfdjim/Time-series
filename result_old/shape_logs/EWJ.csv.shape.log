[cross_view_attention.first_batch]
prompt_feature shape: (16, 8, 256); meaning: intrinsic prompt reasoning features from LLM prompts, [batch*channels, patches, d_model]
semantic_features shape: (16, 8, 256); meaning: fused trend/seasonal/residual component semantics, [batch*channels, patches, d_model]
attention direction after this change: prompt_feature query semantic_features as key/value; output keeps prompt_feature as residual backbone
llm_features shape: (16, 8, 256); meaning: component-guided semantic features enriched by intrinsic prompt information, [batch*channels, patches, d_model]

[detect_multi_fit.train_first_batch]
seq_len/window length: 48
batch_size config: 16
